      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the highlighted card, then tap Buy. Cards give prestige and a permanent gem bonus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击高亮的卡牌，然后点击「购买」。卡牌能提供声望点数和一个永久宝石。"
          }
