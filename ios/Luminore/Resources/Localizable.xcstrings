    "tutorial.intro.1.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This short tutorial walks you through a designed game so you can learn every core action hands-on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个简短的教学会带你走完一局精心设计的对局，亲手学会每一个核心操作。"
          }
        }
      }
    },
    "tutorial.intro.1.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
