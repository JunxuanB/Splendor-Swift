    "tutorial.duel.freePlay.banner" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free play — buy the highlighted card to reach 20 prestige"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由试玩 · 购买高亮卡牌达到 20 声望"
          }
        }
      }
    },
    "tutorial.duel.intro.1.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You and a teaching opponent share one 5×5 gem board. The guided match uses real Duel rules for every action."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和教学对手共用一块 5×5 宝石棋盘。引导局的每一步都会使用真实双人版规则。"
          }
        }
      }
    },
    "tutorial.duel.intro.1.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Duel for Two"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双人对决"
          }
        }
      }
    },
    "tutorial.duel.intro.2.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Win immediately with 20 total prestige, 10 crowns, or 10 prestige on cards of one bonus color."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总声望达到 20、皇冠达到 10，或同一种奖励颜色的卡牌声望达到 10，均会立即获胜。"
          }
        }
      }
    },
    "tutorial.duel.intro.2.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three Ways to Win"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三种胜利方式"
          }
        }
      }
    },
    "tutorial.duel.intro.3.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gems and Cards tabs switch between the two boards. Tap your opponent's panel to inspect their reserved cards; open yours from the bottom-left, where affordable cards show a Buy button."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“宝石”和“卡牌”标签用于切换两块版图。轻点对手面板可查看其预留牌；从左下角打开自己的预留牌时，可购买的牌会直接显示“购买”按钮。"
          }
        }
      }
    },
    "tutorial.duel.intro.3.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boards and Reserved Cards"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版图与预留牌"
          }
        }
      }
    },
    "tutorial.duel.step.ability.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the highlighted purple card, assign its wild bonus to an existing color, and choose a token to steal. Other power icons grant an extra turn, a matching board token, or a privilege."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买高亮的紫色卡牌，把万能奖励叠加到已有颜色，并选择一枚对手筹码偷取。其他能力图标可提供额外回合、同色棋盘筹码或特权。"
          }
        }
      }
    },
    "tutorial.duel.step.ability.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wild Bonuses and Powers"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "万能奖励与卡牌能力"
          }
        }
      }
    },
    "tutorial.duel.step.discount.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the highlighted card. Your owned colors reduce its printed cost, and this card adds two permanent diamonds for every later purchase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买高亮卡牌。已有颜色会抵扣印刷费用，而这张卡会为之后每次购买提供两个永久钻石。"
          }
        }
      }
    },
    "tutorial.duel.step.discount.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanent and Double Gems"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久宝石与双倍奖励"
          }
        }
      }
    },
    "tutorial.duel.step.finish.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You now have 18 prestige and know every core Duel action. Continue to free play and buy the highlighted two-point card to win; the teaching opponent now uses normal AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你现在拥有 18 声望，并已掌握双人版的核心操作。进入自由试玩后购买高亮的两分卡即可获胜；教学对手接下来会使用普通机器人逻辑。"
          }
        }
      }
    },
    "tutorial.duel.step.finish.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the Duel"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成这场对决"
          }
        }
      }
    },
    "tutorial.duel.step.goal.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The header tracks total prestige, crowns, and your best single-color prestige. Reaching any target wins immediately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部依次显示总声望、皇冠和最高单色声望。任意一条达到目标都会立即获胜。"
          }
        }
      }
    },
    "tutorial.duel.step.goal.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch All Three Goals"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关注三条胜利进度"
          }
        }
      }
    },
    "tutorial.duel.step.gold.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your reserved cards from the bottom-left counter. The affordable card is highlighted—tap its Buy button. Its missing ruby is automatically paid with gold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从左下角的预留计数打开预留牌。可购买的牌会高亮显示，轻点其“购买”按钮；缺少的红宝石会自动使用黄金补足。"
          }
        }
      }
    },
    "tutorial.duel.step.gold.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gold Is Wild"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄金是万能筹码"
          }
        }
      }
    },
    "tutorial.duel.step.line.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A line may be horizontal, vertical, or diagonal. Select the three highlighted diagonal tokens, then tap Take. Your opponent will answer with three identical rubies, giving you a privilege."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直线可以是横向、纵向或斜向。选择高亮的三枚斜线筹码，然后点击“拿取”。对手随后会拿走三枚同色红宝石，因此你将获得一个特权。"
          }
        }
      }
    },
    "tutorial.duel.step.line.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a Straight Line"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿直线拿取"
          }
        }
      }
    },
    "tutorial.duel.step.pearl.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the highlighted line containing two pearls. Pearls pay printed pearl costs but never become permanent discounts; taking two at once grants your opponent a privilege."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿取包含两枚珍珠的高亮直线。珍珠用于支付卡牌上的珍珠费用，但不会形成永久折扣；一次拿走两枚会让对手获得特权。"
          }
        }
      }
    },
    "tutorial.duel.step.pearl.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pearls Are Special"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特殊的珍珠"
          }
        }
      }
    },
    "tutorial.duel.step.privilege.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Use Privilege, then take the highlighted onyx. A privilege is optional and does not end your turn; it cannot take gold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击“使用特权”，再拿走高亮的玛瑙。特权是可选动作，不会结束回合，也不能拿取黄金。"
          }
        }
      }
    },
    "tutorial.duel.step.privilege.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spend a Privilege"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用特权"
          }
        }
      }
    },
    "tutorial.duel.step.replenish.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Refill to place the bag's tokens into empty spaces along the spiral. Refilling gives your opponent a privilege, then you must take a mandatory action."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击“补充”，袋中的筹码会沿螺旋填入空位。补充棋盘会让对手获得一个特权，之后你仍需执行一个主要动作。"
          }
        }
      }
    },
    "tutorial.duel.step.replenish.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refill the Board"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "补充棋盘"
          }
        }
      }
    },
    "tutorial.duel.step.reserve.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the highlighted card and choose Reserve, then select the gold token. A reservation always removes one visible gold from the board and you may hold up to three cards."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开高亮卡牌并选择“预留”，再选择黄金筹码。预留必须拿走棋盘上一枚可见黄金，最多可持有三张预留牌。"
          }
        }
      }
    },
    "tutorial.duel.step.reserve.title" : {
      "extractionState" : "stale",
