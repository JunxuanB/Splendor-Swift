    "tutorial.intro.2.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy development cards and attract nobles to earn prestige. The first player to reach the target prestige wins."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买发展卡、吸引贵族来赚取声望点数。率先达到目标声望的玩家获胜。"
          }
        }
      }
    },
    "tutorial.intro.2.title" : {
