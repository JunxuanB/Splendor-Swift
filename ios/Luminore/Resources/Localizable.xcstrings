    "tutorial.step.gold.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gold can stand in for a gem of any color when buying a card. You may reserve a card only while at least one gold token remains on the board; reserving takes one of them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄金在购买卡牌时可以充当任意颜色的宝石。只有场上至少还剩一枚黄金时才能预留卡牌，预留时会拿走其中一枚。"
          }
        }
      }
    },
    "tutorial.step.gold.title" : {
      "extractionState" : "stale",
      "localizations" : {
