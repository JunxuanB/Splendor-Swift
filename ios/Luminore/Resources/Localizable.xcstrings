        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem tokens sit at the top, nobles in the middle, and the three card rows below. Your gems and cards stay along the bottom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宝石筹码在上方，贵族在中间，三排发展卡在下方，你的宝石和卡牌始终显示在底部。"
          }
        }
      }
    },
