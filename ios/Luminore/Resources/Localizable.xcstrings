      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards you own act as permanent gems that discount every future purchase — you don't spend tokens for them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
