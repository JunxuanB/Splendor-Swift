{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luminore-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "luminore-api.junxuanb.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DIRECTORY", "class_name": "RoomDirectory" },
      { "name": "ROOM_RELAY", "class_name": "RoomRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDirectory", "RoomRelay"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}

